{
  "routes": [
    {
      "src": "/etudes-de-cas/?",
      "status": 308,
      "headers": {
        "Location": "/realisations"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/a-propos/?",
      "dest": "/a-propos.html"
    },
    {
      "src": "/realisations/?",
      "dest": "/realisations.html"
    },
    {
      "src": "/criteres-de-recherche/?",
      "dest": "/criteres-de-recherche.html"
    },
    {
      "src": "/amo/?",
      "dest": "/amo.html"
    },
    {
      "src": "/expertise/?",
      "dest": "/expertise.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact.html"
    },
    {
      "src": "/confidentialite/?",
      "dest": "/confidentialite.html"
    },
    {
      "src": "/partenaires/?",
      "dest": "/partenaires.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
